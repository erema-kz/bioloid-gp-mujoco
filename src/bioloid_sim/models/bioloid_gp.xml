          <joint class="leg" name="r_hip_roll" axis="1 0 0" range="-0.8 0.8"/>
          <inertial pos="0 0 0" mass="0.035" diaginertia="0.000015 0.000015 0.000015"/>
          <body name="r_thigh">
            <joint class="leg" name="r_hip_pitch" axis="0 1 0" range="-1.5 1.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.075" size="0.021" mass="0.21" material="white"/>
            <body name="r_shin" pos="0 0 -0.075">
              <joint class="leg" name="r_knee" axis="0 1 0" range="0 2.0"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.071" size="0.019" mass="0.18" material="metal"/>
              <body name="r_ankle_pitch_link" pos="0 0 -0.071">
                <joint class="leg" name="r_ankle_pitch" axis="0 1 0" range="-1.2 1.2"/>
                <inertial pos="0 0 0" mass="0.035" diaginertia="0.000015 0.000015 0.000015"/>
                <body name="r_foot">
                  <joint class="leg" name="r_ankle_roll" axis="1 0 0" range="-0.8 0.8"/>
                  <geom name="r_foot_collision" type="box" pos="0.022 0 -0.014" size="0.055 0.035 0.014" mass="0.09" material="dark"/>
                  <site name="r_foot_site" pos="0.022 0 -0.028" size="0.006"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <body name="l_hip_yaw_link" pos="0 0.038 -0.064">
        <joint class="leg" name="l_hip_yaw" axis="0 0 1" range="-0.5 0.5"/>
        <inertial pos="0 0 0" mass="0.035" diaginertia="0.000015 0.000015 0.000015"/>
        <body name="l_hip_roll_link">
          <joint class="leg" name="l_hip_roll" axis="1 0 0" range="-0.8 0.8"/>
          <inertial pos="0 0 0" mass="0.035" diaginertia="0.000015 0.000015 0.000015"/>
          <body name="l_thigh">
            <joint class="leg" name="l_hip_pitch" axis="0 1 0" range="-1.5 1.5"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.075" size="0.021" mass="0.21" material="white"/>
            <body name="l_shin" pos="0 0 -0.075">
              <joint class="leg" name="l_knee" axis="0 1 0" range="0 2.0"/>
              <geom type="capsule" fromto="0 0 0 0 0 -0.071" size="0.019" mass="0.18" material="metal"/>
              <body name="l_ankle_pitch_link" pos="0 0 -0.071">
                <joint class="leg" name="l_ankle_pitch" axis="0 1 0" range="-1.2 1.2"/>
                <inertial pos="0 0 0" mass="0.035" diaginertia="0.000015 0.000015 0.000015"/>
                <body name="l_foot">
                  <joint class="leg" name="l_ankle_roll" axis="1 0 0" range="-0.8 0.8"/>
                  <geom name="l_foot_collision" type="box" pos="0.022 0 -0.014" size="0.055 0.035 0.014" mass="0.09" material="dark"/>
                  <site name="l_foot_site" pos="0.022 0 -0.028" size="0.006"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="r_shoulder_pitch_act" joint="r_shoulder_pitch" ctrlrange="-1.3 1.7"/>
    <position name="r_shoulder_roll_act" joint="r_shoulder_roll" ctrlrange="-1.6 1.0"/>
    <position name="r_elbow_act" joint="r_elbow" ctrlrange="-1.8 1.8"/>
    <position name="l_shoulder_pitch_act" joint="l_shoulder_pitch" ctrlrange="-1.3 1.7"/>
    <position name="l_shoulder_roll_act" joint="l_shoulder_roll" ctrlrange="-1.0 1.6"/>
    <position name="l_elbow_act" joint="l_elbow" ctrlrange="-1.8 1.8"/>
    <position class="leg" name="r_hip_yaw_act" joint="r_hip_yaw" ctrlrange="-0.5 0.5"/>
    <position class="leg" name="r_hip_roll_act" joint="r_hip_roll" ctrlrange="-0.8 0.8"/>
    <position class="leg" name="r_hip_pitch_act" joint="r_hip_pitch" ctrlrange="-1.5 1.5"/>
    <position class="leg" name="r_knee_act" joint="r_knee" ctrlrange="0 2.0"/>
    <position class="leg" name="r_ankle_pitch_act" joint="r_ankle_pitch" ctrlrange="-1.2 1.2"/>
    <position class="leg" name="r_ankle_roll_act" joint="r_ankle_roll" ctrlrange="-0.8 0.8"/>
    <position class="leg" name="l_hip_yaw_act" joint="l_hip_yaw" ctrlrange="-0.5 0.5"/>
    <position class="leg" name="l_hip_roll_act" joint="l_hip_roll" ctrlrange="-0.8 0.8"/>
    <position class="leg" name="l_hip_pitch_act" joint="l_hip_pitch" ctrlrange="-1.5 1.5"/>
    <position class="leg" name="l_knee_act" joint="l_knee" ctrlrange="0 2.0"/>
    <position class="leg" name="l_ankle_pitch_act" joint="l_ankle_pitch" ctrlrange="-1.2 1.2"/>
    <position class="leg" name="l_ankle_roll_act" joint="l_ankle_roll" ctrlrange="-0.8 0.8"/>
  </actuator>

  <sensor>
    <framequat name="torso_orientation" objtype="body" objname="torso"/>
    <gyro name="torso_gyro" site="imu"/>
    <accelerometer name="torso_accel" site="imu"/>
    <touch name="r_foot_touch" site="r_foot_site"/>
    <touch name="l_foot_touch" site="l_foot_site"/>
  </sensor>

  <keyframe>
    <key name="home"
      qpos="0 0 0.235 1 0 0 0  0 0.16 -0.16 0 -0.16 0.16  0 0 -0.18 0.36 -0.18 0  0 0 -0.18 0.36 -0.18 0"
      ctrl="0 0.16 -0.16 0 -0.16 0.16  0 0 -0.18 0.36 -0.18 0  0 0 -0.18 0.36 -0.18 0"/>
  </keyframe>
</mujoco>
