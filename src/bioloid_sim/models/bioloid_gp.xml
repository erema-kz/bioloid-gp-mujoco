<mujoco model="bioloid_gp_18dof">
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" integrator="implicitfast" solver="Newton" iterations="50" gravity="0 0 -9.81"/>

  <default>
    <joint damping="0.08" armature="0.003" frictionloss="0.01" limited="true"/>
    <geom condim="4" friction="1.0 0.02 0.002" solref="0.008 1" solimp="0.9 0.95 0.002"/>
    <position kp="18" kv="0.7" forcerange="-2.5 2.5"/>
    <default class="leg">
      <joint damping="0.12" armature="0.006"/>
      <position kp="35" kv="1.2" forcerange="-8 8"/>
    </default>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2"/>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.16 0.18 0.20" rgb2="0.22 0.24 0.27" width="512" height="512"/>
    <material name="floor" texture="grid" texrepeat="8 8" reflectance="0.15"/>
    <material name="white" rgba="0.82 0.85 0.90 1"/>
    <material name="dark" rgba="0.08 0.10 0.13 1"/>
    <material name="red" rgba="0.74 0.10 0.08 1"/>
    <material name="metal" rgba="0.34 0.37 0.42 1"/>
  </asset>

  <worldbody>
    <light pos="1 -1 2" dir="-1 1 -2" diffuse="0.9 0.9 0.9"/>
    <geom name="floor" type="plane" size="4 4 0.1" material="floor"/>
    <camera name="tracking" mode="trackcom" pos="0.9 -0.9 0.55" xyaxes="0.707 0.707 0 -0.28 0.28 0.92"/>

    <body name="torso" pos="0 0 0.235">
      <freejoint name="root"/>
      <geom name="torso_collision" type="box" size="0.043 0.055 0.060" mass="0.48" material="red"/>
      <geom class="visual" type="box" size="0.047 0.059 0.064" material="red"/>
      <site name="imu" size="0.006" rgba="0 1 0 1"/>

      <body name="head" pos="0 0 0.095">
        <geom type="ellipsoid" size="0.045 0.042 0.050" mass="0.09" material="white"/>
        <geom class="visual" type="box" pos="0.041 0 0" size="0.006 0.026 0.014" material="dark"/>
      </body>

      <body name="r_shoulder_pitch_link" pos="0 -0.064 0.038">
        <joint name="r_shoulder_pitch" axis="0 1 0" range="-1.3 1.7"/>
        <inertial pos="0 0 0" mass="0.025" diaginertia="0.00001 0.00001 0.00001"/>
        <body name="r_shoulder_roll_link">
          <joint name="r_shoulder_roll" axis="1 0 0" range="-1.6 1.0"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.075" size="0.018" mass="0.15" material="white"/>
          <body name="r_forearm" pos="0 0 -0.075">
            <joint name="r_elbow" axis="0 1 0" range="-1.8 1.8"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.070" size="0.016" mass="0.10" material="metal"/>
          </body>
        </body>
      </body>
      <body name="l_shoulder_pitch_link" pos="0 0.064 0.038">
        <joint name="l_shoulder_pitch" axis="0 1 0" range="-1.3 1.7"/>
        <inertial pos="0 0 0" mass="0.025" diaginertia="0.00001 0.00001 0.00001"/>
        <body name="l_shoulder_roll_link">
          <joint name="l_shoulder_roll" axis="1 0 0" range="-1.0 1.6"/>
          <geom type="capsule" fromto="0 0 0 0 0 -0.075" size="0.018" mass="0.15" material="white"/>
          <body name="l_forearm" pos="0 0 -0.075">
            <joint name="l_elbow" axis="0 1 0" range="-1.8 1.8"/>
            <geom type="capsule" fromto="0 0 0 0 0 -0.070" size="0.016" mass="0.10" material="metal"/>
          </body>
        </body>
      </body>

      <body name="r_hip_yaw_link" pos="0 -0.038 -0.064">
        <joint class="leg" name="r_hip_yaw" axis="0 0 1" range="-0.5 0.5"/>
        <inertial pos="0 0 0" mass="0.035" diaginertia="0.000015 0.000015 0.000015"/>
